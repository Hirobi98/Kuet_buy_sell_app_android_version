<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FBD0C7"
    android:padding="30dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUYER LOGIN"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/txtRollLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="KUET Roll"
        android:backgroundTint="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:layout_marginBottom="15dp"/>

    <EditText
        android:id="@+id/pfPasswordLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:backgroundTint="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="LOGIN"
        android:backgroundTint="#DA6DBC"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvGoToBuyerSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No account? Sign up here"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:padding="10dp"/>
</LinearLayout>